  "mcpToolModules": [
    {
      "id": "at365.speak.read-aloud",
      "title": "読み上げツール",
      "description": "Speakのユーザー辞書・文章分割・再生開始設定を使って読み上げます。接続先や声は[setting:tts]で設定できます。",
      "apiProfile": "speech",
      "responseMode": "accepted",
      "settingsKeys": [
        "connectionNameMatch",
        "additionTiming",
        "prefixText",
        "prefixNewline",
        "suffixText",
        "suffixNewline",
        "splitEnabled",
        "splitMode",
        "targetCharacters",
        "splitCharacters",
        "splitOnNewline",
        "splitOnSpace",
        "startMode",
        "startCount",
        "startSeconds",
        "dictionaryEnabled",
        "dictionaryIgnoreCase"
      ],
      "tools": [
        {
          "name": "appdock_speech_speak",
          "title": "Speak: 文章を読み上げる",
          "description": "文章を受信すると、辞書変換・文章分割・読み上げキュー登録を待たずに受信結果を返します。textに文章、instructionsに話し方や感情などのニュアンスを指定してください。サーバー名やIDはユーザーの指定に従い、省略時は既定の接続を使います。発信元が分かる場合はsourceに実際の端末名やチャット・タスクのタイトルなどを添えてください。応答後は次の作業へ進んでください。",
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text": {
                "type": "string",
                "pattern": "\\S",
                "description": "読み上げる文章。"
              },
              "connectionId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}$",
                "description": "音声サーバーのID。名前より優先します。"
              },
              "connectionName": {
                "type": "string",
                "description": "ユーザーが指定した音声サーバー名。"
              },
              "instructions": {
                "type": "string",
                "description": "話し方や感情などのニュアンス。"
              },
              "source": {
                "type": "object",
                "description": "監査用の自己申告の発信元。オブジェクトも各項目も省略できます。",
                "additionalProperties": false,
                "properties": {
                  "clientName": { "type": "string", "description": "呼び出し元のアプリ名。" },
                  "deviceName": { "type": "string", "description": "呼び出し元が動作する端末名。" },
                  "chatTitle": { "type": "string", "description": "送信時のチャットタイトル。" },
                  "taskTitle": { "type": "string", "description": "送信時のタスクタイトル。" },
                  "chatId": { "type": "string", "description": "呼び出し元のチャットID。" }
                }
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "accepted": {
                "const": true
              }
            },
            "required": ["accepted"],
            "additionalProperties": false
          },
          "annotations": {
            "readOnlyHint": false,
            "destructiveHint": false,
            "idempotentHint": false,
            "openWorldHint": true
          }
        }
      ]
    }
  ]
}

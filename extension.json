    }
  ],
  "mcpToolModules": [
    {
      "id": "at365.speak.read-aloud",
      "title": "読み上げツール",
      "description": "Speakのユーザー辞書・文章分割・再生開始設定を使って読み上げます。",
      "apiProfile": "speech",
      "settingsKeys": [
        "additionTiming",
        "prefixText",
        "prefixNewline",
        "suffixText",
        "suffixNewline",
        "splitEnabled",
        "targetCharacters",
        "splitCharacters",
        "splitOnNewline",
        "splitOnSpace",
        "startMode",
        "startCount",
        "startSeconds",
        "dictionaryEnabled",
        "dictionaryIgnoreCase"
      ],
      "tools": [
        {
          "name": "appdock_speech_speak",
          "title": "Speak: 文章を読み上げる",
          "description": "文章を指定した接続で読み上げます。textに文章、instructionsに話し方や感情などのニュアンスを指定してください。接続はconnectionIdを優先し、未指定ならconnectionName、どちらも指定しなければ既定を使います。",
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text": {
                "type": "string",
                "pattern": "\\S",
                "description": "読み上げる文章。"
              },
              "connectionId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}$",
                "description": "音声サーバーのID。名前より優先します。"
              },
              "connectionName": {
                "type": "string",
                "description": "音声サーバーの名前。設定順の完全一致で選び、一致しなければ既定を使います。"
              },
              "instructions": {
                "type": "string",
                "description": "話し方や感情などのニュアンス。"
              }
            }
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "accepted": {
                "const": true
              }
            },
            "required": ["accepted"],
            "additionalProperties": false
          },
          "annotations": {
            "readOnlyHint": false,
            "destructiveHint": false,
            "idempotentHint": false,
            "openWorldHint": true
          }
        }
      ]
    }
  ]
}

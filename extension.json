{
  "apiVersion": 1,
  "id": "at365.speak",
  "name": "Applet.Speak.at365",
  "displayName": "Speak",
  "tagline": "AIの言葉に、声を。",
  "description": "音声生成AIを使って、AIの言葉を読み上げるMCPツールです。文章の自動分割やユーザー辞書で、読み上げを好みに合わせられます。",
  "version": "0.10.0",
  "minimumHostVersion": "0.249.6",
  "runtime": "node",
  "entry": "index.cjs",
  "capabilities": [
    "settings",
    "providers",
    "file-dialog",
    "appdock-api",
    "mcp-tool-modules",
    "storage"
  ],
  "settings": [
    {
      "key": "additionTiming",
      "title": "前後の文章を追加するタイミング",
      "type": "select",
      "default": "before-split",
      "options": [
        { "label": "分割前に追加する", "value": "before-split" },
        { "label": "分割後に各部分へ追加する", "value": "after-split" }
      ],
      "description": "分割後は、本文の各部分すべてに前後の文章を付けます。追加後には再分割しません。"
    },
    {
      "key": "prefixText",
      "title": "前に付ける文章",
      "type": "string",
      "default": "",
      "description": "本文の前へ追加します。空欄なら追加しません。"
    },
    {
      "key": "prefixNewline",
      "title": "前の文章の後に改行を入れる",
      "type": "boolean",
      "default": true,
      "description": "OFFでは本文と直接つなぎます。"
    },
    {
      "key": "suffixText",
      "title": "後に付ける文章",
      "type": "string",
      "default": "",
      "description": "本文の後へ追加します。空欄なら追加しません。"
    },
    {
      "key": "suffixNewline",
      "title": "後の文章の前に改行を入れる",
      "type": "boolean",
      "default": true,
      "description": "OFFでは本文と直接つなぎます。"
    },
    {
      "key": "splitEnabled",
      "title": "文章を自動分割する",
      "type": "boolean",
      "default": true
    },
    {
      "key": "targetCharacters",
      "title": "分割の目安文字数",
      "type": "number",
      "minimum": 1,
      "integer": true,
      "step": 1,
      "default": 300,
      "description": "目安の前後で最も近い指定の区切りを選びます。同じ距離なら手前を選び、区切りがなければ途中で分割しません。"
    },
    {
      "key": "splitCharacters",
      "title": "分割に使う文字",
      "type": "string",
      "default": "。.",
      "description": "入力した各文字の直後を分割候補にします。例：「。.!?」。読点「、」を使う場合は追加してください。空欄では改行・スペースの設定だけを使います。"
    },
    {
      "key": "splitOnNewline",
      "title": "改行を分割候補にする",
      "type": "boolean",
      "default": true
    },
    {
      "key": "splitOnSpace",
      "title": "スペースを分割候補にする",
      "type": "boolean",
      "default": false,
      "description": "半角・全角スペースなどの空白とタブを対象にします。英文の途中で区切られると、読み上げの抑揚やつながりが変わる場合があります。"
    },
    {
      "key": "startMode",
      "title": "再生開始方式",
      "type": "select",
      "default": "first",
      "options": [
        {
          "label": "最初の1個ができたら",
          "value": "first"
        },
        {
          "label": "指定個数ができたら",
          "value": "count"
        },
        {
          "label": "全部できたら",
          "value": "all"
        },
        {
          "label": "最初の生成後に指定秒数待つ",
          "value": "delay"
        }
      ]
    },
    {
      "key": "startCount",
      "title": "開始までに生成する個数",
      "type": "number",
      "minimum": 1,
      "integer": true,
      "step": 1,
      "default": 2,
      "description": "「指定個数ができたら」で使用します。部分の総数が少ない場合は全部そろうと開始します。"
    },
    {
      "key": "startSeconds",
      "title": "最初の生成後に待つ秒数",
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "秒数方式で使用します。小数を指定できます。0秒は最初の1個ができたら開始します。"
    },
    {
      "key": "dictionaryEnabled",
      "title": "辞書で置き換える",
      "type": "boolean",
      "default": true
    },
    {
      "key": "dictionaryIgnoreCase",
      "title": "英字の大文字・小文字を区別しない",
      "type": "boolean",
      "default": true,
      "description": "半角英字（A–Z／a–z）の違いを無視して照合します。元の文章やCSVの表記は保持します。"
    }
  ],
  "settingSections": [
    {
      "id": "publication",
      "title": "MCP公開",
      "mcpModules": ["at365.speak.read-aloud"]
    },
    {
      "id": "text-additions",
      "title": "前後の文章",
      "description": "前後の文章も辞書変換の対象になります。分割後は各部分に追加します。",
      "settings": [
        "additionTiming",
        "prefixText",
        "prefixNewline",
        "suffixText",
        "suffixNewline"
      ]
    },
    {
      "id": "splitting",
      "title": "自動分割",
      "settings": [
        "splitEnabled",
        "targetCharacters",
        "splitCharacters",
        "splitOnNewline",
        "splitOnSpace"
      ]
    },
    {
      "id": "playback",
      "title": "再生開始",
      "settings": ["startMode", "startCount", "startSeconds"]
    },
    {
      "id": "dictionary",
      "title": "辞書変換",
      "settings": ["dictionaryEnabled", "dictionaryIgnoreCase"]
    }
  ],
  "settingsTabs": [
    {
      "id": "settings",
      "title": "設定",
      "sections": [
        "publication",
        "text-additions",
        "splitting",
        "playback",
        "dictionary"
      ],
      "provider": "helpers/settings"
    },
    {
      "id": "user-dictionary",
      "title": "ユーザー辞書",
      "sections": [],

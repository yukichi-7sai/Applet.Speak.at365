{
  "apiVersion": 1,
  "id": "at365.speak",
  "name": "Applet.Speak.at365",
  "displayName": "Speak",
  "tagline": "AIの言葉に、声を。",
  "description": "音声生成AIを使って、AIの言葉を読み上げるMCPツールです。文章の自動分割やユーザー辞書で、読み上げを好みに合わせられます。",
  "version": "0.4.0",
  "minimumHostVersion": "0.249.0",
  "runtime": "node",
  "entry": "index.cjs",
  "capabilities": [
    "settings",
    "providers",
    "file-dialog",
    "appdock-api",
    "mcp-tool-modules",
    "storage"
  ],
  "settings": [
    {
      "key": "splitEnabled",
      "title": "文章を自動分割する",
      "type": "boolean",
      "default": true
    },
    {
      "key": "targetCharacters",
      "title": "分割の目安文字数",
      "type": "number",
      "minimum": 1,
      "integer": true,
      "step": 1,
      "default": 300,
      "description": "段落や文末に合わせて区切るため、目安を超える場合があります。"
    },
    {
      "key": "startMode",
      "title": "再生開始方式",
      "type": "select",
      "default": "first",
      "options": [
        {
          "label": "最初の1個ができたら",
          "value": "first"
        },
        {
          "label": "指定個数ができたら",
          "value": "count"
        },
        {
          "label": "全部できたら",
          "value": "all"
        },
        {
          "label": "最初の生成後に指定秒数待つ",
          "value": "delay"
        }
      ]
    },
    {
      "key": "startCount",
      "title": "開始までに生成する個数",
      "type": "number",
      "minimum": 1,
      "integer": true,
      "step": 1,
      "default": 2,
      "description": "「指定個数ができたら」で使用します。部分の総数が少ない場合は全部そろうと開始します。"
    },
    {
      "key": "startSeconds",
      "title": "最初の生成後に待つ秒数",
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "秒数方式で使用します。小数を指定できます。0秒は最初の1個ができたら開始します。"
    },
    {
      "key": "dictionaryEnabled",
      "title": "辞書で置き換える",
      "type": "boolean",
      "default": true
    }
  ],
  "settingSections": [
    {
      "id": "publication",
      "title": "MCP公開",
      "mcpModules": ["at365.speak.read-aloud"]
    },
    {
      "id": "splitting",
      "title": "自動分割",
      "settings": ["splitEnabled", "targetCharacters"]
    },
    {
      "id": "playback",
      "title": "再生開始",
      "settings": ["startMode", "startCount", "startSeconds"]
    },
    {
      "id": "dictionary",
      "title": "自動置き換え",
      "settings": ["dictionaryEnabled"]
    }
  ],
  "settingsTabs": [
    {
      "id": "settings",
      "title": "設定",
      "sections": ["publication", "splitting", "playback", "dictionary"],
      "provider": "helpers/settings"
    },
    {
      "id": "user-dictionary",
      "title": "ユーザー辞書",
      "sections": [],
      "provider": "helpers/user-dictionary"
    },
    {
      "id": "source-dictionaries",
      "title": "配布辞書",
      "sections": [],
      "provider": "helpers/source-dictionaries"
    }
  ],
  "settingsProviders": [
    {
      "id": "helpers",
      "key": "helpers",
      "title": "辞書と文章の補助操作",
      "scope": "device",
      "tabs": [

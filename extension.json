{
  "apiVersion": 1,
  "id": "at365.speak",
  "name": "Applet.Speak.at365",
  "displayName": "Speak",
  "tagline": "AIの言葉に、声を。",
  "description": "[setting:tts]を使って、AIの言葉を読み上げるMCPツールです。文章の自動分割やユーザー辞書で、読み上げを好みに合わせられます。",
  "version": "0.22.0",
  "minimumHostVersion": "0.307.0",
  "runtime": "node",
  "entry": "index.cjs",
  "capabilities": [
    "settings",
    "providers",
    "file-dialog",
    "appdock-api",
    "mcp-tool-modules",
    "storage"
  ],
  "settings": [
    {
      "key": "connectionNameMatch",
      "title": "サーバー名の照合方式",
      "type": "select",
      "default": "prefix",
      "options": [
        { "label": "完全一致", "value": "exact" },
        { "label": "前方一致", "value": "prefix" }
      ],
      "description": "読み上げツールに渡されたサーバー名を照合します。「完全一致」は登録名全体が同じサーバーを選びます。「前方一致」は設定一覧の上から、指定した名前で始まる最初のサーバーを選びます。"
    },
    {
      "key": "recordSpeechSource",
      "title": "読み上げの発信元を記録する",
      "type": "boolean",
      "default": false,
      "automation": false,
      "description": "「監査ログの内容をマスクする」がONでも、読み上げツールに渡された端末名・チャットタイトルなどを監査ログに保存します。OFFでは発信元を保存しません。"
    },
    {
      "key": "recordSpeechText",
      "title": "読み上げの本文を記録する",
      "type": "boolean",
      "default": false,
      "automation": false,
      "description": "「監査ログの内容をマスクする」がONでも、読み上げツールが受け取った原文を受付時に1回だけ保存します。OFFでは本文を監査ログに保存しません。"
    },
    {
      "key": "saveAudio",
      "title": "読み上げた音声を自動保存",
      "type": "boolean",
      "default": false,
      "localOnly": true,
      "description": "Speakの読み上げと試聴で、再生を開始した部分の元のWAVを保存します。"
    },
    {
      "key": "audioDirectory",
      "title": "WAVの保存先",
      "type": "string",
      "format": "directory",
      "directoryBase": "space",
      "default": "",
      "localOnly": true,
      "visibleWhen": { "key": "saveAudio", "equals": true },
      "description": "初期の保存先はスペースです。「選ぶ」でWindowsのフォルダー選択を開きます。"
    },
    {
      "key": "audioByServer",
      "title": "サーバー名ごとにフォルダーを分ける",
      "type": "boolean",
      "default": true,
      "localOnly": true,
      "visibleWhen": { "key": "saveAudio", "equals": true },
      "description": "実際に読み上げに使った音声サーバーの登録名でフォルダーを作ります。"
    },
    {
      "key": "combineAudio",
      "title": "分割した音声を1本のWAVにまとめる",
      "type": "boolean",
      "default": false,
      "localOnly": true,
      "visibleWhen": { "key": "saveAudio", "equals": true },
      "description": "再生した部分を順番につないで保存します。オフでは部分ごとのWAVを保存します。"
    },
    {
      "key": "additionTiming",
      "title": "前後の文章を追加するタイミング",
      "type": "select",
      "default": "before-split",
      "options": [
        { "label": "分割前に追加する", "value": "before-split" },
        { "label": "分割後に各部分へ追加する", "value": "after-split" }
      ],
      "description": "分割後は、本文の各部分すべてに前後の文章を付けます。追加後には再分割しません。"
    },
    {
      "key": "prefixText",
      "title": "前に付ける文章",
      "type": "string",
      "default": "",
      "description": "本文の前へ追加します。空欄なら追加しません。"
    },
    {
      "key": "prefixNewline",
      "title": "前の文章の後に改行を入れる",
      "type": "boolean",
      "default": true,
      "description": "OFFでは本文と直接つなぎます。"
    },
    {
      "key": "suffixText",
      "title": "後に付ける文章",
      "type": "string",
      "default": "",
      "description": "本文の後へ追加します。空欄なら追加しません。"
    },
    {
      "key": "suffixNewline",
      "title": "後の文章の前に改行を入れる",
      "type": "boolean",
      "default": true,
      "description": "OFFでは本文と直接つなぎます。"
    },
    {
      "key": "splitEnabled",
      "title": "文章を自動分割する",
      "type": "boolean",
      "default": true
    },
    {
      "key": "splitMode",
      "title": "分割方式",
      "type": "select",
      "default": "sentences",
      "options": [
        { "label": "指定した文字で分割", "value": "characters" },
        { "label": "文単位で分割", "value": "sentences" }
      ],
      "description": "文単位では文章から文の区切りを判定します。どちらも目安文字数に近い区切りを選びます。"
    },
    {
      "key": "targetCharacters",
      "title": "分割の目安文字数",
      "type": "number",
      "minimum": 1,
      "integer": true,
      "step": 1,
      "default": 300,
      "description": "目安の前後で最も近い指定の区切りを選びます。同じ距離なら手前を選び、区切りがなければ途中で分割しません。"
    },
    {
      "key": "splitCharacters",
      "title": "分割に使う文字",
      "type": "string",
      "default": ".!?。！？．｡",
      "visibleWhen": { "key": "splitMode", "equals": "characters" },
      "description": "入力した各文字の直後を候補にします。連続する区切り文字は末尾でまとめて区切ります。読点やリーダーは必要な場合だけ追加してください。空欄では改行・スペースの設定だけを使います。"
    },
    {
      "key": "splitOnNewline",
      "visibleWhen": { "key": "splitMode", "equals": "characters" },
      "title": "改行を分割候補にする",
      "type": "boolean",
      "default": true
    },
    {
      "key": "splitOnSpace",
      "visibleWhen": { "key": "splitMode", "equals": "characters" },
      "title": "スペースを分割候補にする",
      "type": "boolean",
      "default": false,
      "description": "半角・全角スペースなどの空白とタブを対象にします。英文の途中で区切られると、読み上げの抑揚やつながりが変わる場合があります。"
    },
    {
      "key": "startMode",
      "title": "再生開始方式",
      "type": "select",
      "default": "first",
      "options": [
        {
          "label": "最初の1個ができたら",
          "value": "first"
        },
        {
          "label": "指定個数ができたら",
          "value": "count"
        },
        {
          "label": "全部できたら",
          "value": "all"
        },
        {
          "label": "最初の生成後に指定秒数待つ",
          "value": "delay"
        }
      ]
    },
    {
      "key": "startCount",
      "title": "開始までに生成する個数",
      "type": "number",
      "minimum": 1,
      "integer": true,
      "step": 1,
      "default": 2,
      "description": "「指定個数ができたら」で使用します。部分の総数が少ない場合は全部そろうと開始します。"
    },
    {
      "key": "startSeconds",
      "title": "最初の生成後に待つ秒数",
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "秒数方式で使用します。小数を指定できます。0秒は最初の1個ができたら開始します。"
    },
    {
      "key": "dictionaryEnabled",
      "title": "辞書で置き換える",
      "type": "boolean",
      "default": true
    },
    {
      "key": "dictionaryIgnoreCase",
      "title": "英字の大文字・小文字を区別しない",
      "type": "boolean",
      "default": true,
      "description": "半角英字（A–Z／a–z）の違いを無視して照合します。元の文章やCSVの表記は保持します。"
    }
  ],
  "speechArchive": {
    "enabled": "saveAudio",
    "directory": "audioDirectory",
    "byServer": "audioByServer",
    "combine": "combineAudio"
  },
  "settingSections": [
    {
      "id": "publication",
      "title": "基本設定",
      "settings": ["connectionNameMatch"],
      "mcpModules": ["at365.speak.read-aloud"]
    },
    {
      "id": "audit-log",
      "title": "監査ログ",
      "settings": ["recordSpeechSource", "recordSpeechText"]
    },
    {
      "id": "text-additions",
      "title": "前後の文章",
      "description": "前後の文章も辞書変換の対象になります。分割後は各部分に追加します。",
      "settings": [
        "additionTiming",
        "prefixText",
        "prefixNewline",
        "suffixText",
        "suffixNewline"
      ]
    },
    {
      "id": "splitting",
      "title": "自動分割",
      "settings": [
        "splitEnabled",
        "splitMode",
        "targetCharacters",
        "splitCharacters",
        "splitOnNewline",
        "splitOnSpace"
      ]
    },
    {
      "id": "playback",
      "title": "再生開始",
      "settings": ["startMode", "startCount", "startSeconds"]
    },
    {
      "id": "audio-files",
      "title": "音声の保存",
      "settings": ["saveAudio", "audioDirectory", "audioByServer", "combineAudio"]
    },
    {
      "id": "dictionary",
      "title": "辞書変換",
      "settings": ["dictionaryEnabled", "dictionaryIgnoreCase"]
    }
  ],
  "settingsTabs": [
    {
      "id": "settings",
      "icon": "settings",
      "title": "設定",
      "sections": [
        "publication",
        "audit-log",
        "text-additions",
        "splitting",
        "playback",
        "audio-files",
        "dictionary"
      ],
      "provider": "helpers/settings",
      "toolbarSection": "publication"
    },
    {
      "id": "user-dictionary",
      "icon": "book-user",
      "title": "ユーザー辞書",
      "sections": [],
      "provider": "helpers/user-dictionary",
      "toolbarList": "user-words"
    },
    {
      "id": "source-dictionaries",
      "icon": "books",
      "title": "配布辞書",
      "sections": [],
      "provider": "helpers/source-dictionaries",
      "toolbarList": "source-dictionaries"
    }
  ],
